# Copy to apps/server/.env (ignored by git). All values are optional.

# 监听地址：默认只允许本机访问，勿随意改为 0.0.0.0
HOST=127.0.0.1
PORT=4000

# SQLite 文件路径（相对 apps/server 目录）
DATABASE_PATH=./data/autosdd.db

# 模型 API Key 兜底（也可在「模型管理」界面录入；界面录入优先）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Mock 执行器每片输出的延迟（毫秒），E2E 用 5
MOCK_DELAY_MS=250

# 设置后，名称（步骤名或任务标题）与之相同的步骤会立即失败，用于演示失败态
MOCK_FAIL_STEP=

# 单步超时（秒）
STEP_TIMEOUT_SECONDS=300
